NEXT_PUBLIC_SUPABASE_URL=https://heevhgaqrspefpzfbacz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta de Supabase (Settings -> API -> service_role).
# NUNCA la expongas en el cliente. Necesaria para crear el primer
# entrenador y para que el entrenador cree accesos de jugadores.
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones push (opcional). Genera el par de claves VAPID con:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Email SMTP (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@metrikas.pro
SMTP_PASS=your_password_here

# Firma de webhooks de MercadoPago (opcional pero recomendado).
# Panel de MercadoPago -> Webhooks -> "Clave secreta".
# Si no se define, los webhooks siguen funcionando: igual re-consultan el pago
# contra la API de MercadoPago antes de activar nada.
MP_WEBHOOK_SECRET=

# Clave para tareas programadas (cron-job.org) y el respaldo manual
# GET /api/admin/export
CRON_SECRET=
